@page "/minhasturmas"
@inject NavigationManager Nav

<PageTitle>Minhas Turmas - Nexus</PageTitle>

<div class="container mt-4">
    <h3>Minhas Turmas</h3>
    <hr />

    <div class="row">
        @foreach (var turma in turmas)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@turma.Nome</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@turma.Codigo</h6>
                        <p class="card-text">Status: <span class="badge bg-info text-dark">Em andamento</span></p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <button class="btn btn-outline-primary btn-sm w-100">Ver Conteúdo</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Turma> turmas = new()
    {
        new Turma { Nome = "Sistemas Distribuídos", Codigo = "SD-2026-1" },
        new Turma { Nome = "Interacao Humano-Computador e UX", Codigo = "IHC-2026-1" },
        new Turma { Nome = "Programação C# Avançada", Codigo = "CS-ADV" }
    };

    public class Turma { public string Nome { get; set; } public string Codigo { get; set; } }
}