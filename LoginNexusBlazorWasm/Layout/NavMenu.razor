@using LoginNexusBlazorWasm.Services
@inject AuthService AuthService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Nexus Acadêmico</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @* Só mostra o Login se NÃO houver usuário logado *@
        @if (AuthService.CurrentUser == null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="oi oi-account-login" aria-hidden="true"></span> Acesso Nexus
                </NavLink>
            </div>
        }

        @* Só mostra áreas restritas se houver usuário logado *@
        @if (AuthService.CurrentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dashboard">
                    <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="counter">
                    <span class="oi oi-book" aria-hidden="true"></span> Minhas Turmas
                </NavLink>
            </div>
            
            @* Bônus: Item específico para Professor *@
            @if (AuthService.CurrentUser.Role == "Professor")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="notas">
                        <span class="oi oi-pencil" aria-hidden="true"></span> Lançar Notas
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        // Subscreve ao evento para redesenhar o menu quando o login/logout ocorrer
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        // Limpa a subscrição para evitar memory leaks
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}